# ProGrowth AI Overview — environment variables.
#
# Copy to .env.local for development and fill in real values. Never commit
# .env.local or any file containing real credentials — .gitignore already
# excludes .env*.local (see the "local env files" section).

# ── Supabase (shared: internal product + public grader) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── DataForSEO (shared: internal product + public grader) ────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Daily spend cap in USD, shared across the internal product's own paid
# calls AND the grader's (see GRADER_DAILY_RUN_LIMIT below for the
# grader's own, independent guard). Default in code: 5.
DATAFORSEO_DAILY_CAP=50

# ── xAI (Grok citations — internal product only, not used by the grader) ─
XAI_API_KEY=

# ── Matomo (AI-traffic attribution — internal product only) ──────────────
MATOMO_URL=
MATOMO_TOKEN_AUTH=

# ── Brevo SMTP (OTP + digest emails — internal product only) ─────────────
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# ── Auth / cron / batch (internal product only) ───────────────────────────
JWT_SECRET=
CRON_SECRET=
BATCH_API_KEY=
DIGEST_EMAIL_RECIPIENT=

# ── Deployment protection (internal product only — see lib/publicOrigin.ts)
PUBLIC_ORIGIN=

# ── ProGrowth AI Grader (public product) ──────────────────────────────────
# Daily cap on the NUMBER of grader runs (not dollars — see
# lib/grader/spend-guard.ts for why a run count, not a cost sum, is the
# guard). Protects the shared DATAFORSEO_DAILY_CAP above from public
# traffic. Default in code: 300.
GRADER_DAILY_RUN_LIMIT=300
# Both OFF by default. Each adds one extra live DataForSEO/LLM call per
# report when enabled — see lib/grader/query-generator.ts and
# lib/grader/summary.ts for exactly what they do and their cost/latency
# impact before turning either on.
GRADER_LLM_QUERIES=false
GRADER_LLM_SUMMARY=false

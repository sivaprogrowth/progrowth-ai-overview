# ProGrowth AI Overview — environment variables.
#
# Copy to .env.local for development and fill in real values. Never commit
# .env.local or any file containing real credentials — .gitignore already
# excludes .env*.local (see the "local env files" section).

# ── Supabase (shared: internal product + public grader) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── DataForSEO (shared: internal product + public grader) ────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Daily spend cap in USD, shared across the internal product's own paid
# calls AND the grader's (see GRADER_DAILY_RUN_LIMIT below for the
# grader's own, independent guard). Default in code: 5.
DATAFORSEO_DAILY_CAP=50

# ── xAI (Grok citations — internal product only, not used by the grader) ─
XAI_API_KEY=

# ── Matomo (AI-traffic attribution — internal product only) ──────────────
MATOMO_URL=
MATOMO_TOKEN_AUTH=

# ── Brevo SMTP (OTP + digest emails — internal product only) ─────────────
BREVO_SMTP_USER=
BREVO_SMTP_PASS=

# ── Auth / cron / batch (internal product only) ───────────────────────────
JWT_SECRET=
CRON_SECRET=
BATCH_API_KEY=
DIGEST_EMAIL_RECIPIENT=

# ── Deployment protection (internal product only — see lib/publicOrigin.ts)
PUBLIC_ORIGIN=

# ── ProGrowth AI Grader (public product) ──────────────────────────────────
# Daily cap on the NUMBER of grader runs (not dollars — see
# lib/grader/spend-guard.ts for why a run count, not a cost sum, is the
# guard). Protects the shared DATAFORSEO_DAILY_CAP above from public
# traffic. Default in code: 300.
GRADER_DAILY_RUN_LIMIT=300
# Both OFF by default. Each adds one extra live DataForSEO/LLM call per
# report when enabled — see lib/grader/query-generator.ts and
# lib/grader/summary.ts for exactly what they do and their cost/latency
# impact before turning either on.
GRADER_LLM_QUERIES=false
GRADER_LLM_SUMMARY=false
# Worker-pool size for the DataForSEO (query × engine) fan-out — see
# lib/grader/concurrency.ts. Falls back to 4 on anything missing/invalid,
# clamped to 12 max regardless of what's set here. Default in code: 4
# (today's production behavior) — see the Phase 1 performance report before
# raising it.
GRADER_PROVIDER_CONCURRENCY=4
# Number of grader queries generated per report — see
# lib/grader/query-count.ts. Falls back to 8 on anything missing/invalid,
# clamped to [8, 12]. Default in code: 8 (Phase 2 — was a flat 12 before;
# see the Phase 2 performance report for why 8, not 10).
GRADER_QUERY_COUNT=8

# ── ProElevate server-to-server integration (optional) ────────────────────
# Shared secret for authenticating ProElevate's SERVER when it calls
# POST /api/grader/analyze or GET /api/grader/report/[id] directly (see
# lib/grader/api-auth.ts). Sent as `Authorization: Bearer <value>`.
#
# NOT required for the public grader website to keep working — the
# browser never sends this header today and never will (it must never
# reach client code, hence no NEXT_PUBLIC_ prefix), so leaving this unset
# does not break or degrade the existing public product in any way. It
# only enables the additional authenticated path for ProElevate's server.
#
# Generate a long, random value (e.g. `openssl rand -hex 32`) and share it
# with the ProElevate deployment through a secrets manager or your
# platform's encrypted environment variable store — never through chat,
# email, or a committed file. Rotate it the same way if it's ever exposed.
PROELEVATE_API_KEY=

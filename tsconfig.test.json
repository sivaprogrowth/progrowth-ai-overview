{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["lib/grader/**/*.ts", "lib/recommendations.ts", "lib/clientInput.ts", "tests/grader/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
